{
  "System":{
    "Application":[
      {
        "name": "Audioplayer",
        "display": {
          "name": "Audio Player"
        },
        "package": "raxon/{{$this.name|>string.lowercase}}",
        "frontend": "{{Package.Raxon.AudioPlayer:Setup:install.frontend.get(options())}}",
        "backend": "{{Package.Raxon.AudioPlayer:Setup:install.backend.get(options())}}",
        "config": {
          "application": "Application/{{$this.#parentNode.#parentNode.name}}/",
          "icon": "Application/{{$this.#parentNode.#parentNode.name}}/Icon/Icon.png"
        },
        "source": {
          "node": {
            "extension" : "{{config('project.dir.node')}}Data/System.Server.Extension.json",
            "content_type": "{{config('project.dir.node')}}Data/System.Server.ContentType.json"
          },
          "extension": "{{config('controller.dir.data')}}System.Server.Extension.json",
          "content_type": "{{config('controller.dir.data')}}System.Server.ContentType.json"
        },
        "method": null,
        "target": null,
        "description": "Audio Player (Playing mp3, wav & ogg)",
        "user": "{{Package.Raxon.AudioPlayer:Setup:user.list(flags(), options(), $this)}}",
        "extension": "{{Package.Raxon.AudioPlayer:Setup:extension.list(flags(), options(), $this)}}"
      }
    ]
  }
}